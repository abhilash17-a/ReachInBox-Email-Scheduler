# Copy this file to backend/.env
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
SESSION_SECRET=replace-with-a-long-random-secret
WORKER_CONCURRENCY=10
DEFAULT_MIN_DELAY_MS=2000
DEFAULT_HOURLY_LIMIT=200
MAX_EMAIL_BATCH_SIZE=5000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASS=
ETHEREAL_FROM_NAME=ReachInbox Demo
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/oauth/callback
SLACK_SCOPES=chat:write,im:write
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=admin

# Live delivery (optional; Ethereal remains the default)
